{
  "compilerOptions": {
    "strict": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "../src/game/**/*.ts"],
  "exclude": ["../src/game/**/*.test.ts", "../src/game/**/__tests__/**", "../src/game/ui/**", "../src/game/store/**", "../src/game/table3d/**", "../src/game/save/**"]
}
