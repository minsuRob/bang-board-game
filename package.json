    "firebase-tools": "^15.30.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "start": "expo start --port 8085",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android --port 8085",
    "ios": "expo start --ios --port 8085",
    "web": "expo start --web --port 8085",
    "lint": "expo lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project demo-bang \"vitest run --config vitest.rules.config.mts\"",
    "typecheck": "tsc --noEmit",
    "simulate": "tsx scripts/simulate.ts",
    "gen:sfx": "node scripts/gen-sfx.mjs",
    "postinstall": "setup-skia-web public"
    "deploy": "expo export --platform web && firebase deploy --only hosting",
  },
  "private": true
